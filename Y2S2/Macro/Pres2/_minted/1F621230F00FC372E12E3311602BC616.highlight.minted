\PYG{n}{beta\PYGZus{}hat} \PYG{o}{=} \PYG{n}{nne}\PYG{o}{.}\PYG{n}{predict}\PYG{p}{(}\PYG{n}{moments}\PYG{p}{(}\PYG{n}{y\PYGZus{}obs}\PYG{p}{)}\PYG{o}{.}\PYG{n}{reshape}\PYG{p}{(}\PYG{l+m+mi}{1}\PYG{p}{,}\PYG{o}{\PYGZhy{}}\PYG{l+m+mi}{1}\PYG{p}{))}
