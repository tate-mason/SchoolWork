
@article{stevenson_beyond_2010,
	title = {Beyond the {Classroom}: {Using} {Title} {IX} to {Measure} the {Return} to {High} {School} {Sports}},
	volume = {92},
	issn = {0034-6535},
	url = {https://doi.org/10.1162/rest.2010.11623},
	doi = {10.1162/rest.2010.11623},
	abstract = {Between 1972 and 1978 U.S. high schools rapidly increased their female athletic participation rates in order to comply with Title IX. This paper examines the causal implications of this expansion by using variation in the level of boys' athletic participation across states before Title IX to instrument for change in girls' athletic participation. Analysis of differences in outcomes across states in changes between pre- and postcohorts reveals that a 10 percentage point rise in state-level female sports participation generates a 1 percentage point increase in female college attendance and a 1 to 2 percentage point rise in female labor force participation.},
	number = {2},
	journal = {The Review of Economics and Statistics},
	author = {Stevenson, Betsey},
	month = may,
	year = {2010},
	note = {\_eprint: https://direct.mit.edu/rest/article-pdf/92/2/284/1617566/rest.2010.11623.pdf},
	pages = {284--301},
	file = {PDF:/Users/tate/Zotero/storage/TYTSAR95/Stevenson - NBER WORKING PAPER SERIES.pdf:application/pdf},
}

@article{logan_youth_2020,
	title = {Youth sports participation and health status in early adulthood: {A} 12-year follow-up},
	volume = {19},
	issn = {22113355},
	shorttitle = {Youth sports participation and health status in early adulthood},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S221133552030067X},
	doi = {10.1016/j.pmedr.2020.101107},
	abstract = {Examining association between serial participation in youth organized sports (OS) and concurrent cardiometabolic risk factors, with long-term health status, will aid understanding the role of OS participation. Combining data from a prospective study and a follow-up survey, we aimed to determine association between youth OS participation and cardiometabolic risk factors with health and physical activity (PA) in young adulthood. Cardiometabolic risk factors were monitored yearly, and OS involvement through middle school, high school, and college, together with current status was recorded 12 years after the initial study began; 462 participants completed follow-up. Cardiometabolic risk factors included: body mass index (BMI), waist circumference, blood pressure, total cholesterol, high-density lipoprotein (HDL), low-density lipoprotein (LDL) cholesterol and triglycerides, fasting glucose and insulin. Participants continuing OS participation from middle to high school and/ or college had signiﬁcantly lower BMI/BMI z-scores [24.7 vs 27.4 (p {\textless} 0.05) and 0.51 vs 0.82 (p {\textless} 0.05), respectively] and signiﬁcantly higher HDL [48.7 vs 45.4 (p ≤ 0.05)] than those without OS participation after middle school. Waist circumference of females was signiﬁcantly smaller in those who participated in OS from middle to high school and/or college (84.9 cm) compared to those who had no OS (92.1 cm), (p {\textless} 0.05). Participants continuing OS from middle to high school and/or college reported signiﬁcantly higher follow-up PA levels than those who had no OS after middle school (p {\textless} 0.001). This study provides novel data showing serial participation in OS from middle to high school and/or college was associated with a superior cardiometabolic health proﬁle in school and increased PA levels at 12-year follow-up.},
	language = {en},
	urldate = {2026-02-17},
	journal = {Preventive Medicine Reports},
	author = {Logan, Kelsey and Lloyd, Rhodri S. and Schafer-Kalkhoff, Tara and Khoury, Jane C. and Ehrlich, Shelley and Dolan, Lawrence M. and Shah, Amy S. and Myer, Gregory D.},
	month = sep,
	year = {2020},
	pages = {101107},
	file = {PDF:/Users/tate/Zotero/storage/HUUZSX3F/Logan et al. - 2020 - Youth sports participation and health status in early adulthood A 12-year follow-up.pdf:application/pdf},
}

@article{frick_trickle-down_2016,
	title = {The trickle-down effect: how elite sporting success affects amateur participation in {German} football},
	volume = {23},
	issn = {1350-4851, 1466-4291},
	shorttitle = {The trickle-down effect},
	url = {http://www.tandfonline.com/doi/full/10.1080/13504851.2015.1068916},
	doi = {10.1080/13504851.2015.1068916},
	abstract = {The trickle-down effect assumes that sporting success at the elite sport level descends down to the amateur sport level in the sense that people are inspired by sporting success to participate themselves. Previous research failed to find convincing evidence for this relationship, mostly because the data used and the methods applied (e.g. cross-sectional data, primary data, correlations) were not adequate. This study addresses these shortcomings and examines the effect of national sporting success on amateur sport participation in German football using longitudinal data from 1950 to 2014. Since an individual’s decision to participate in sport also depends on other factors, the regression models also control for working hours, real wages etc. The results show that only World Cup title wins of the men’s national team have a positive and statistically significant impact on the number of and percentage changes in individual club memberships, clubs and teams. The coefficients of European Championship titles and title wins of the women’s national team turn out to be mostly insignificant. Future research should examine the reasons as to why only title wins by the men’s team have a measurable inspirational effect on amateur sport participation in football.},
	language = {en},
	number = {4},
	urldate = {2026-05-02},
	journal = {Applied Economics Letters},
	author = {Frick, B. and Wicker, P.},
	month = mar,
	year = {2016},
	pages = {259--263},
	file = {PDF:/Users/tate/Zotero/storage/WZ52SVUU/Frick and Wicker - 2016 - The trickle-down effect how elite sporting success affects amateur participation in German football.pdf:application/pdf},
}

@article{reilly_effects_2024,
	title = {Effects of the {Women}'s {National} {Basketball} {Association} on {High} {School} {Sports} and {College} {Enrollment}},
	issn = {1556-5068},
	url = {https://www.ssrn.com/abstract=4814099},
	doi = {10.2139/ssrn.4814099},
	abstract = {We analyze the impact of the Women’s National Basketball Association (WNBA) on high school sports participation and college enrollment in the US. Using state-level panel data from the National Federation of High School Associations (NFHS), we find that in states where WNBA teams were established, the number of women basketball participants increased by 1.2-2.1 players per high school. Furthermore, using data from the Integrated Postsecondary Education Data System (IPEDS), we find women college enrollment in cities with WNBA teams rose by 246 to 467, depending on the model. The relative rate of women to men enrollment increased by 0.17 to 0.25, especially in Division III institutions. Our findings are robust to the staggered WNBA team roll-out, the establishment of the American Basketball League, and legislative impacts like Title IX and the Equity in Athletics Disclosure Act.},
	language = {en},
	urldate = {2026-05-02},
	journal = {SSRN Electronic Journal},
	author = {Reilly, Patrick and Rodriguez, Zachary},
	year = {2024},
	file = {PDF:/Users/tate/Zotero/storage/EHVRJCQM/Reilly and Rodriguez - 2024 - Effects of the Women's National Basketball Association on High School Sports and College Enrollment.pdf:application/pdf},
}

@article{beck_female_2022,
