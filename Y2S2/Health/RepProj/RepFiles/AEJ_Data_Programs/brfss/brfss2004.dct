_column(73)    int   srhealth           %1f    "self reported health, 1=excellent to 5=poor"
_column(83)    int   exercise           %1f    "exercise in past month, 1=yes, 2=no, 7=DK, 9=refuse"
_column(74)    int   phys_poor          %2f    "# days per month poor physical health"
_column(76)    int   mental_poor        %2f    "# days per month poor mental health"
_column(109)   int   age                %2f    "age in years"
_column(119)   int   marital            %1f    "marital status 1=marr 2=widow 3=div 4=sep 5=nev mar 6=couple 9=DK"
_column(120)   int   kids               %2f    "# of kids in household"
_column(122)   int   educ               %1f    "education recode"
_column(123)   int   employ             %1f    "employment, 1=wages, 2=self-employ, 3=jobless<1 yr, 4=jobless>1 yr, 5=homemaker, 6=student, 7=retired, 8=unable, 9=DK"
_column(124)   int   income94           %2f    "family income, post 1994 coding"
_column(126)   int   weight             %4f    "weight in pounds"
_column(130)   int   height             %4f    "height in inches"
_column(134)   int   county             %3f    "county of residence"
_column(140)   int   sex                %1f    "sex, 1=male, 2=female"
_column(829)   int   smoke_status       %1f    "smoking status, 1=all, 2=some, 3=former, 4=never, 9=DK"
_column(873)   int   race5              %1f    "race/ethnicity 1=w(NH), 2=b(NH), 3=o(nh) 4=mixed(NH) 5=Hispanic"
_column(844)   int   alcoholic          %1f    "chronic drinking, 1=not at risk, 2=at risk, 9=DK"
_column(840)   int   totaldrinks        %4f    "total number of drinks per month"
_column(187)   int   active_duty        %1f    "military duty, 1=yes, 2=national guard or reserves"
_column(760)   double  finalwgt         %10f   "final weight"
}
