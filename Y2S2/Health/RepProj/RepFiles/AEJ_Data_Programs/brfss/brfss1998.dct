dictionary using CDBRFS98.ASC{
_column(1)     int   fips               %2f    "fips state code"
_column(12)    int   month              %2f    "month of interview"
_column(14)    int   day                %2f    "day of interview"
_column(16)    int   year               %2f    "year of interview"
_column(31)    int   adults		%2f    "# adults in household"
_column(35)    int   srhealth           %1f    "self reported health, 1=excellent to 5=poor"
_column(53)    int   exercise           %1f    "exercise in past month, 1=yes, 2=no, 7=DK, 9=refuse"
_column(36)    int   phys_poor          %2f    "# days per month poor physical health"
_column(38)    int   mental_poor        %2f    "# days per month poor mental health"
_column(669)   int   phys_act           %1f    "activity level, 1=sedentary, 2=irregular, 3=regular, 4=vigorous, 9=DK"
_column(117)   int   age                %2f    "age in years"
_column(121)   int   marital            %1f    "marital status 1=marr 2=widow 3=div 4=sep 5=nev mar 6=couple 9=DK"
_column(122)   int   kids_under_5       %1f    "# of kids in household under 5"
_column(123)   int   kids5_12           %1f    "kids between 5 and 12"
_column(124)   int   kids13_17          %1f    "kids between 13 and 17"
_column(125)   int   educ               %1f    "education recode"
_column(126)   int   employ             %1f    "employment, 1=wages, 2=self-employ, 3=jobless<1 yr, 4=jobless>1 yr, 5=homemaker, 6=student, 7=retired, 8=unable, 9=DK"
_column(127)   int   income94           %2f    "family income, post 1994 coding"
_column(129)   int   weight             %3f    "weight in pounds"
_column(135)   int   height             %3f    "height in inches"
_column(138)   int   county             %3f    "county of residence"
_column(143)   int   sex                %1f    "sex, 1=male, 2=female"
_column(656)   int   smoke_status       %1f    "smoking status, 1=all, 2=some, 3=former, 4=never, 9=DK"
_column(694)   int   race4              %1f    "race/ethnicity 1=w(NH), 2=b(NH), 3=Hispanic 4=other(NH) 5=DK"
_column(676)   int   fruit_veggie       %1f    "fruit & vegetable index, 1=once a day or never, 2=one to three times a day, 3=three to five times a day, 4=five or more times, 9=DK"
_column(683)   int   alcoholic          %1f    "chronic drinking, 1=not at risk, 2=at risk, 9=DK"
_column(657)   int   totaldrinks        %4f    "total number of drinks per month"
_column(632)   double  finalwgt         %10f   "final weight"
}
