(results tab7kids_cardiosum_pois are active now)

. foreach i in albumin crp anyinfl {
  2.     estimates restore tab7kids_`i'
  3.     scalar b7kids_`i'  = _b[dd_treat]
  4.     scalar se7kids_`i' = _se[dd_treat]
  5.     scalar p7kids_`i'  = 2*ttail(e(df_r), abs(_b[dd_treat]/_se[dd_treat]))
  6. }
(results tab7kids_albumin are active now)
(results tab7kids_crp are active now)
(results tab7kids_anyinfl are active now)

. foreach suf in inflsum_pois {
  2.     estimates restore tab7kids_`suf'
  3.     scalar b7kids_`suf'  = _b[dd_treat]
  4.     scalar se7kids_`suf' = _se[dd_treat]
  5.     scalar p7kids_`suf'  = 2*normal(-abs(_b[dd_treat]/_se[dd_treat]))
  6. }
(results tab7kids_inflsum_pois are active now)

. 
. // Pre-expansion means
. foreach v in riskyglycatedhemoglobin riskyCholest riskyhdl anymetab ///
>              riskydiastolic riskysystolic riskypulse anycardio ///
>              riskyAlbumin riskycrp anyinflamation {
  2.     quietly sum `v' if year == 0 & twoplus_kids == 1 & highgrade <= 2
  3.     scalar pm7_`v' = r(mean)
  4. }

