. estimates store tab4c6_phys

. restore

. 
. // ---- Extract Tab4 scalars ----
. // Cols 1-5: treatment variable is dd_treatment
. // Col 6: treatment variable is treatment (triple diff)
. // OLS outcomes (at_work, excel): ttail p-value
. // nbreg outcomes (mental, phys): normal approximation p-value
. 
. foreach col in c1 c2 c3 c4 c5 {
  2.     foreach y in at_work excel {
  3.         estimates restore tab4`col'_`y'
  4.         scalar b4_`col'_`y'  = _b[dd_treatment]
  5.         scalar se4_`col'_`y' = _se[dd_treatment]
  6.         scalar p4_`col'_`y'  = 2*ttail(e(df_r), abs(_b[dd_treatment]/_se[dd_treatm
> ent]))
  7.     }
  8.     foreach y in mental phys {
  9.         estimates restore tab4`col'_`y'
 10.         scalar b4_`col'_`y'  = _b[dd_treatment]
 11.         scalar se4_`col'_`y' = _se[dd_treatment]
 12.         scalar p4_`col'_`y'  = 2*normal(-abs(_b[dd_treatment]/_se[dd_treatment]))
 13.     }
 14. }
(results tab4c1_at_work are active now)
(results tab4c1_excel are active now)
(results tab4c1_mental are active now)
(results tab4c1_phys are active now)
(results tab4c2_at_work are active now)
(results tab4c2_excel are active now)
(results tab4c2_mental are active now)
(results tab4c2_phys are active now)
(results tab4c3_at_work are active now)
(results tab4c3_excel are active now)
(results tab4c3_mental are active now)
(results tab4c3_phys are active now)
(results tab4c4_at_work are active now)
(results tab4c4_excel are active now)
(results tab4c4_mental are active now)
(results tab4c4_phys are active now)
(results tab4c5_at_work are active now)
(results tab4c5_excel are active now)
(results tab4c5_mental are active now)
(results tab4c5_phys are active now)

. 
. // Col 6 uses the triple-diff treatment variable
. foreach y in at_work excel {
  2.     estimates restore tab4c6_`y'
  3.     scalar b4_c6_`y'  = _b[treatment]
  4.     scalar se4_c6_`y' = _se[treatment]
  5.     scalar p4_c6_`y'  = 2*ttail(e(df_r), abs(_b[treatment]/_se[treatment]))
  6. }
(results tab4c6_at_work are active now)
(results tab4c6_excel are active now)

. foreach y in mental phys {
  2.     estimates restore tab4c6_`y'
  3.     scalar b4_c6_`y'  = _b[treatment]
  4.     scalar se4_c6_`y' = _se[treatment]
  5.     scalar p4_c6_`y'  = 2*normal(-abs(_b[treatment]/_se[treatment]))
  6. }
(results tab4c6_mental are active now)
(results tab4c6_phys are active now)

