. /************************************************************
> * (2) Switches for Running Individual Sections              *
> ************************************************************/
. 
. // Below I define a local switch for each section. If the 
. // switch is equal to 1 it will run; at 0 it is dormant.
. 
. local Tab2     = 0

. local Tab3     = 0

. local Tab4     = 0

. local Tab5     = 1 // descriptives only: obs, sample mean, % risky

. local Tab6     = 0

. local Tab7     = 0

. local Fig4     = 0 // parallel trends; vline at 1996; 5 subfigures

. local ARC      = 0 // robustness: Footnote 12 (col1), Footnote 21 (col2-3)

. local Extension = 0 

. /************************************************************
> * (3) Section Calls                                         *
> ************************************************************/
. 
. if `Tab2'      do `codePath'Tab2.do      `dataPath' `outPath'

. if `Tab3'      do `codePath'Tab3.do      `dataPath' `outPath'

. if `Tab4'      do `codePath'Tab4.do      `dataPath' `outPath'

. if `Tab5'      do `codePath'Tab5.do      `dataPath' `outPath'

. /************************************************************
> * Tab5.do                                                   *
> * Table 5 - NHANES Biomarker Descriptives                  *
> *                                                           *
> * Args: 1 = dataPath, 2 = outPath                          *
> *                                                           *
> * Loads the stacked NHANES data, constructs all biomarker   *
> * risk indicators, writes Tab5.tex with obs/mean/% risky,   *
> * and saves nhanescleaned.dta for use by Tab6 and Tab7.     *
> ************************************************************/
. 
. local dataPath "`1'"

. local outPath  "`2'"

. 
. use `dataPath'nhanes/nhanesallstacked.dta, clear

. 
. // Sample restrictions: women aged 21-40, black/white/hispanic only
. drop if age < 21 | age > 40
(51,589 observations deleted)

. drop if sex == 1
(5,773 observations deleted)

. drop if race > 3 | race < 0
(277 observations deleted)

. 
. // Approximate children in household (family size minus adults)
. gen kids = .
(6,686 missing values generated)

. replace kids = family_size-1 if marital > 1 & year == 0
(1,984 real changes made)

. replace kids = family_size-2 if marital == 1 & year == 0
(1,996 real changes made)

. replace kids = dmdhhsiz-1    if marital > 1 & year > 0
(1,267 real changes made)

. replace kids = dmdhhsiz-2    if marital == 1 & year > 0
(1,439 real changes made)

. 
. // Education indicator (no high school or less)
. gen no_hs = highgrade <= 2

. 
. // Keep only mothers
. drop if kids <= 0
(935 observations deleted)

. 
. // Treatment variables
. gen twoplus_kids = kids > 1

. gen eitc_expand  = year > 0

. gen dd_treat     = eitc_expand * twoplus_kids

. gen eitc_nohs    = eitc_expand * no_hs

. gen twoplus_nohs = twoplus_kids * no_hs

. gen ddd_treat    = dd_treat * no_hs

. 
. // Biomarker cleaning
. replace crp = . if crp == 88888
(199 real changes made, 199 to missing)

. 
. gen riskycrp                    = crp >= 0.3

. replace riskycrp                = . if crp == .
(614 real changes made, 614 to missing)

. replace riskypulse              = . if pulse == .
(366 real changes made, 366 to missing)

. replace riskydiastolic          = . if diastolic == .
(609 real changes made, 609 to missing)

. replace riskysystolic           = . if systolic == .
(602 real changes made, 602 to missing)

. replace riskyhdl                = . if hdl == .
(623 real changes made, 623 to missing)

. replace riskyCholest            = . if cholesterol == .
(609 real changes made, 609 to missing)

. replace riskyAlbumin            = . if albumin == .
(636 real changes made, 636 to missing)

. replace riskyglycatedhemoglobin = . if glycatedhemoglobin == .
(552 real changes made, 552 to missing)

. 
. // Composite risk indices
. gen metabsum  = riskyglycatedhemoglobin + riskyCholest + riskyhdl
(640 missing values generated)

. gen cardiosum = riskysystolic + riskydiastolic + riskypulse
(609 missing values generated)

. gen inflsum   = riskycrp + riskyAlbumin
(637 missing values generated)

. gen totalsum  = metabsum + cardiosum + inflsum
(1,081 missing values generated)

. 
. gen anymetab = metabsum > 0

. replace anymetab = . if riskyglycatedhemoglobin == . | riskyCholest == . | riskyhdl == .
(640 real changes made, 640 to missing)

. gen anycardio = cardiosum > 0

. replace anycardio = . if riskypulse == . | riskydiastolic == . | riskysystolic == .
(609 real changes made, 609 to missing)

. gen anyinflamation = inflsum > 0

. replace anyinflamation = . if riskyAlbumin == . | riskycrp == .
(637 real changes made, 637 to missing)

. 
. replace crp = 0.21 if crp < 0.21
(844 real changes made)

. 
. gen total1 = totalsum > 0

. replace total1 = . if totalsum == .
(1,081 real changes made, 1,081 to missing)

. gen total2 = totalsum > 1

. replace total2 = . if totalsum == .
(1,081 real changes made, 1,081 to missing)

. gen total3 = totalsum > 2

. replace total3 = . if totalsum == .
(1,081 real changes made, 1,081 to missing)

. 
. // Drop missings before saving cleaned file and computing descriptives
. drop if marital == . | race == . | age == . | no_hs == . | kids == .
(431 observations deleted)

. 
