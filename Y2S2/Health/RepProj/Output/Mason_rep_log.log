.   // ---- Extract Tab7 scalars ----
.   // OLS rows: ttail p-value; Poisson/NB rows: normal z p-value
. 
.   // Panel A: Metabolic
.   foreach m in hba1c cholest hdl anymetab {
  2.       estimates restore tab7dd_`m'
  3.       scalar b7dd_`m'  = _b[dd_treat]
  4.       scalar se7dd_`m' = _se[dd_treat]
  5.       scalar p7dd_`m'  = 2*ttail(e(df_r), abs(_b[dd_treat]/_se[dd_treat]))
  6.       estimates restore tab7ddd_`m'
  7.       scalar b7ddd_`m'  = _b[ddd_treat]
  8.       scalar se7ddd_`m' = _se[ddd_treat]
  9.       scalar p7ddd_`m'  = 2*ttail(e(df_r), abs(_b[ddd_treat]/_se[ddd_treat]))
 10.   }
