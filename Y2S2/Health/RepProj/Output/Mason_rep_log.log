.   estimates store phys_adj
. 
.   // ---- Extract scalars for file write ----
. 
.   // Pre-expansion means for treatment group (
> 2+ kids, educ<=2, pre-1996)
.   foreach y in at_work excel_vgood mental_poor
>  phys_poor {
  2.       quietly sum `y' if year < 1996 & twop
> lus_kids == 1 & educ <= 2
  3.       scalar premean_`y' = r(mean)
  4.   }
. 
.   // Extract b, se, p for each outcome x spec
.   // OLS: use e(df_r) for t-based p-value
.   // nbreg: use normal approximation (z-stat)
. 
.   estimates restore working_simple
(results working_simple are active now)
.   scalar b_at_work_simple  = _b[dd_treatment]
.   scalar se_at_work_simple = _se[dd_treatment]
.   scalar p_at_work_simple  = 2*ttail(e(df_r), 
> abs(_b[dd_treatment]/_se[dd_treatment]))
. 
.   estimates restore working_adj
(results working_adj are active now)
.   scalar b_at_work_adj  = _b[dd_treatment]
.   scalar se_at_work_adj = _se[dd_treatment]
.   scalar p_at_work_adj  = 2*ttail(e(df_r), abs
> (_b[dd_treatment]/_se[dd_treatment]))
. 
.   estimates restore excel_simple
(results excel_simple are active now)
.   scalar b_excel_vgood_simple  = _b[dd_treatme
> nt]
.   scalar se_excel_vgood_simple = _se[dd_treatm
> ent]
.   scalar p_excel_vgood_simple  = 2*ttail(e(df_
> r), abs(_b[dd_treatment]/_se[dd_treatment]))
. 
.   estimates restore excel_adj
(results excel_adj are active now)
.   scalar b_excel_vgood_adj  = _b[dd_treatment]
.   scalar se_excel_vgood_adj = _se[dd_treatment
> ]
.   scalar p_excel_vgood_adj  = 2*ttail(e(df_r),
>  abs(_b[dd_treatment]/_se[dd_treatment]))
. 
.   estimates restore mental_simple
(results mental_simple are active now)
.   scalar b_mental_poor_simple  = _b[dd_treatme
> nt]
.   scalar se_mental_poor_simple = _se[dd_treatm
> ent]
.   scalar p_mental_poor_simple  = 2*normal(-abs
> (_b[dd_treatment]/_se[dd_treatment]))
. 
.   estimates restore mental_adj
(results mental_adj are active now)
.   scalar b_mental_poor_adj  = _b[dd_treatment]
.   scalar se_mental_poor_adj = _se[dd_treatment
> ]
.   scalar p_mental_poor_adj  = 2*normal(-abs(_b
> [dd_treatment]/_se[dd_treatment]))
. 
.   estimates restore phys_simple
(results phys_simple are active now)
.   scalar b_phys_poor_simple  = _b[dd_treatment
> ]
.   scalar se_phys_poor_simple = _se[dd_treatmen
> t]
.   scalar p_phys_poor_simple  = 2*normal(-abs(_
> b[dd_treatment]/_se[dd_treatment]))
. 
