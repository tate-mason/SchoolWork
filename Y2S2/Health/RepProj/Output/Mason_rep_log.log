.   // ---- Extract Tab4 scalars ----
.   // Cols 1-5: dd_treatment; Col 6: treatment (triple diff)
.   // OLS outcomes: at_work, excel  -> ttail p-value
.   // nbreg outcomes: mental, phys  -> normal p-value
. 
.   foreach col in c1 c2 c3 c4 c5 {
  2.       local tvar "dd_treatment"
  3.       foreach y in at_work excel {
  4.           estimates restore tab4`col'_`y'
  5.           scalar b4_`col'_`y'  = _b[`tvar']
  6.           scalar se4_`col'_`y' = _se[`tvar']
  7.           scalar p4_`col'_`y'  = 2*ttail(e(df_r), abs(_b[`tvar']/_se[`tvar']))
  8.       }
  9.       foreach y in mental phys {
 10.           estimates restore tab4`col'_`y'
 11.           scalar b4_`col'_`y'  = _b[`tvar']
 12.           scalar se4_`col'_`y' = _se[`tvar']
 13.           scalar p4_`col'_`y'  = 2*normal(-abs(_b[`tvar']/_se[`tvar']))
 14.       }
 15.   }
(results tab4c1_at_work are active now)
(results tab4c1_excel are active now)
(results tab4c1_mental are active now)
(results tab4c1_phys are active now)
(results tab4c2_at_work are active now)
(results tab4c2_excel are active now)
(results tab4c2_mental are active now)
(results tab4c2_phys are active now)
(results tab4c3_at_work are active now)
(results tab4c3_excel are active now)
(results tab4c3_mental are active now)
(results tab4c3_phys are active now)
(results tab4c4_at_work are active now)
(results tab4c4_excel are active now)
(results tab4c4_mental are active now)
(results tab4c4_phys are active now)
(results tab4c5_at_work are active now)
(results tab4c5_excel are active now)
(results tab4c5_mental are active now)
(results tab4c5_phys are active now)
.   // Col 6 uses treatment variable
.   foreach y in at_work excel {
  2.       estimates restore tab4c6_`y'
  3.       scalar b4_c6_`y'  = _b[treatment]
  4.       scalar se4_c6_`y' = _se[treatment]
  5.       scalar p4_c6_`y'  = 2*ttail(e(df_r), abs(_b[treatment]/_se[treatment]))
  6.   }
(results tab4c6_at_work are active now)
(results tab4c6_excel are active now)
.   foreach y in mental phys {
  2.       estimates restore tab4c6_`y'
  3.       scalar b4_c6_`y'  = _b[treatment]
  4.       scalar se4_c6_`y' = _se[treatment]
  5.       scalar p4_c6_`y'  = 2*normal(-abs(_b[treatment]/_se[treatment]))
  6.   }
(results tab4c6_mental are active now)
(results tab4c6_phys are active now)
. 
.   // ---- Write Tab4 LaTeX ----
. 
.   file open tab4 using `outPath'Tables/Tab4.tex, write replace
.   file write tab4 "\begin{table}[htbp]" _n
.   file write tab4 "\centering" _n
.   file write tab4 "\caption{Robustness Tests, Women Aged 21--40, 1993--2001 BRFSS}" _
> n
.   file write tab4 "\resizebox{\textwidth}{!}{%" _n
.   file write tab4 "\begin{tabular}{lcccccc}" _n
.   file write tab4 "\toprule" _n
.   file write tab4 " & DD & DD state$\times$year & 2 vs 0 kids & DD married & DD singl
> e & DDD \\" _n
.   file write tab4 "Outcome & Method & FE & & & & \\" _n
.   file write tab4 "\midrule" _n
. 
.   // Helper macro: write one row of 6 cols
.   // Usage: call for each outcome with its stored scalars
.   // at_work
.   file write tab4 "At work (OLS)"
.   foreach col in c1 c2 c3 c4 c5 c6 {
  2.       local val = strtrim(string(scalar(b4_`col'_at_work), "%9.4f"))
  3.       file write tab4 " & `val'"
  4.   }
.   file write tab4 " \\" _n
.   foreach col in c1 c2 c3 c4 c5 c6 {
  2.       local val = strtrim(string(scalar(se4_`col'_at_work), "%9.4f"))
  3.       file write tab4 " & (`val')"
  4.   }
.   file write tab4 " \\" _n
.   foreach col in c1 c2 c3 c4 c5 c6 {
  2.       local val = strtrim(string(scalar(p4_`col'_at_work), "%9.3f"))
  3.       file write tab4 " & [`val']"
  4.   }
.   file write tab4 " \\" _n
.   file write tab4 "\addlinespace" _n
. 
.   // excel_vgood
.   file write tab4 "Exc./very good health (OLS)"
.   foreach col in c1 c2 c3 c4 c5 c6 {
  2.       local val = strtrim(string(scalar(b4_`col'_excel), "%9.4f"))
  3.       file write tab4 " & `val'"
  4.   }
.   file write tab4 " \\" _n
.   foreach col in c1 c2 c3 c4 c5 c6 {
  2.       local val = strtrim(string(scalar(se4_`col'_excel), "%9.4f"))
  3.       file write tab4 " & (`val')"
  4.   }
.   file write tab4 " \\" _n
.   foreach col in c1 c2 c3 c4 c5 c6 {
  2.       local val = strtrim(string(scalar(p4_`col'_excel), "%9.3f"))
  3.       file write tab4 " & [`val']"
  4.   }
.   file write tab4 " \\" _n
.   file write tab4 "\addlinespace" _n
. 
.   // mental
.   file write tab4 "Bad mental health days (NegBin)"
.   foreach col in c1 c2 c3 c4 c5 c6 {
  2.       local val = strtrim(string(scalar(b4_`col'_mental), "%9.4f"))
  3.       file write tab4 " & `val'"
  4.   }
.   file write tab4 " \\" _n
.   foreach col in c1 c2 c3 c4 c5 c6 {
  2.       local val = strtrim(string(scalar(se4_`col'_mental), "%9.4f"))
  3.       file write tab4 " & (`val')"
  4.   }
.   file write tab4 " \\" _n
.   foreach col in c1 c2 c3 c4 c5 c6 {
  2.       local val = strtrim(string(scalar(p4_`col'_mental), "%9.3f"))
  3.       file write tab4 " & [`val']"
  4.   }
.   file write tab4 " \\" _n
.   file write tab4 "\addlinespace" _n
. 
.   // phys
.   file write tab4 "Bad physical health days (NegBin)"
.   foreach col in c1 c2 c3 c4 c5 c6 {
  2.       local val = strtrim(string(scalar(b4_`col'_phys), "%9.4f"))
  3.       file write tab4 " & `val'"
  4.   }
.   file write tab4 " \\" _n
.   foreach col in c1 c2 c3 c4 c5 c6 {
  2.       local val = strtrim(string(scalar(se4_`col'_phys), "%9.4f"))
  3.       file write tab4 " & (`val')"
  4.   }
.   file write tab4 " \\" _n
.   foreach col in c1 c2 c3 c4 c5 c6 {
  2.       local val = strtrim(string(scalar(p4_`col'_phys), "%9.3f"))
  3.       file write tab4 " & [`val']"
  4.   }
.   file write tab4 " \\" _n
. 
.   file write tab4 "\bottomrule" _n
.   file write tab4 "\end{tabular}}" _n
.   file write tab4 "\begin{minipage}{\linewidth}" _n
.   file write tab4 "\smallskip\footnotesize" _n
.   file write tab4 "\textit{Notes:} Standard errors in parentheses; \$p\$-values in sq
> uare brackets." _n
.   file write tab4 " All standard errors allow for arbitrary correlations within state
> ." _n
.   file write tab4 "\end{minipage}" _n
.   file write tab4 "\end{table}" _n
.   file close tab4
. }

