. 
.   local X_dd "i.year i.age i.marital i.race" // control vector of dummies
. 
.   tab year if highgrade <= 2
. 
.   // Column 1
.   reg total1 dd_treat twoplus_kids `X_dd' if highgrade<=2, robust // Effect on 1+ Risk Factors
