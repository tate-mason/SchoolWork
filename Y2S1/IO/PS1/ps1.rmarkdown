# 1 - Data Import and Descriptive Statistics

```{r}
# Load necessary libraries
library(tidyverse)
library(readr)
library(psych)
library(tidyr)
library(knitr)
```

```{r}
# Import the dataset
df <- read_delim("~/SchoolWork/Y2S1/IO/PS1/IRI.csv")

glimpse(df)
describe(df$brand)
describe(df$parent)
```

# 2 - Descriptive Statistics by Brand
```{r}

cereal_vars <- c("price", "brand_num", "sold",
                  "parent_num", "sugars", "fiber", "flavored", "flavored",
                  "fortified")

df_market <- df %>%
  mutate(
    brand_num = n_distinct(brand),
    parent_num = n_distinct(parent),
    sold = (price * quantity)
  ) %>%
  group_by(week_id, store_id, brand) %>%
  summarise(
    across(all_of(cereal_vars), 
    list(
      mean = ~ mean(.x, na.rm = TRUE),
      sd = ~ sd(.x, na.rm = TRUE),
      median = ~ median(.x, na.rm = TRUE),
      max = ~ max(.x, na.rm = TRUE),
      min = ~ min(.x, na.rm = TRUE),
      n = ~ sum(!is.na(.x))),
    .names = "{.col}_{.fn}"))


```

